    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\n\nfunction cleanText(value) {\n  if (value === null || value === undefined) return \"\";\n\n  return String(value)\n    .trim()\n    .replace(/\\s+/g, \" \");\n}\n\nfunction cleanEmail(value) {\n  return cleanText(value).toLowerCase();\n}\n\nfunction cleanPhone(value) {\n  if (!value) return \"\";\n\n  const digits = String(value).replace(/\\D/g, \"\");\n\n  if (digits.length === 10) {\n    return `+52${digits}`;\n  }\n\n  if (digits.length === 12 && digits.startsWith(\"52\")) {\n    return `+${digits}`;\n  }\n\n  return `+${digits}`;\n}\n\nfunction cleanDate(value) {\n  if (!value) return \"\";\n  return String(value).substring(0, 10);\n}\n\nreturn {\n  json: {\n    recordId: data.id,\n\n    Nombre: cleanText(data.question_Abr46W?.value),\n\n    Email: cleanEmail(data.question_BbEjLA?.value),\n\n    Telefono: cleanPhone(data.question_kRbJ0J?.value),\n\n    Servicio: cleanText(data.question_vxXJ0d?.value),\n\n    Ciudad: cleanText(data.question_KBpWPk?.value),\n\n    Fecha: cleanDate(data.createdAt),\n\n    // Para idempotencia\n    source: \"tally\"\n  }\n};\n\n\n"
      },
