      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fields = $json.fields;\n\nfunction cleanText(value) {\n  if (value === null || value === undefined) return \"\";\n\n  return String(value)\n    .trim()\n    .replace(/\\s+/g, \" \");\n}\n\nfunction cleanEmail(value) {\n  return cleanText(value).toLowerCase();\n}\n\nfunction cleanPhone(value) {\n  if (!value) return \"\";\n\n  const digits = String(value).replace(/\\D/g, \"\");\n\n  if (digits.length === 10) {\n    return `+52${digits}`;\n  }\n\n  if (digits.length === 12 && digits.startsWith(\"52\")) {\n    return `+${digits}`;\n  }\n\n  return `+${digits}`;\n}\n\nfunction cleanArrayValue(value) {\n  if (!Array.isArray(value)) {\n    return cleanText(value);\n  }\n\n  return value\n    .map(item => cleanText(item))\n    .filter(Boolean)\n    .join(\", \");\n}\n\nfunction cleanDate(value) {\n  if (!value) return \"\";\n\n  return String(value).substring(0, 10);\n}\n\nreturn {\n  json: {\n    recordId: $json.id,\n    Nombre: cleanText(fields.Nombre),\n    Email: cleanEmail(fields.Email),\n    Telefono: cleanPhone(fields.Telefono),\n    Servicio: cleanArrayValue(fields[\"Servicio de Interés\"]),\n    Ciudad: cleanArrayValue(fields[\"Estado de la República\"]),\n    Fecha: cleanDate(fields.Creada),\n    source: \"airtable\"\n  }\n};"
      },
